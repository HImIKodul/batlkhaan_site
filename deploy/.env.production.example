# Copy to deploy/.env.production and replace every placeholder. Never commit real secrets.
DATABASE_URL=postgresql://MMRI_RUNTIME_USER:PASSWORD@DB_HOST:5432/mmri?schema=public&sslmode=require
MIGRATION_DATABASE_URL=postgresql://MMRI_MIGRATION_USER:PASSWORD@DB_HOST:5432/mmri?schema=public&sslmode=require
ACCESS_TOKEN_ISSUER=mmri-api
ACCESS_TOKEN_AUDIENCE=mmri-web
ACCESS_TOKEN_SECRET=REPLACE_WITH_RANDOM_64_PLUS_CHARS
PASSWORD_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_64_PLUS_CHARS
AUDIT_HASH_SALT=REPLACE_WITH_DIFFERENT_RANDOM_64_PLUS_CHARS
METRICS_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_PLUS_CHARS
ALLOWED_ORIGINS=https://mmri.example.com
COOKIE_SECURE=true
REFRESH_COOKIE_NAME=__Secure-mmri_refresh
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
RELEASE_SHA=REPLACE_WITH_GIT_SHA
INSTANCE_ID=REPLACE_WITH_INSTANCE_ID
READINESS_DB_TIMEOUT_MS=3000
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_FORCE_TIMEOUT_MS=45000
REQUEST_BODY_LIMIT_BYTES=1000000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
API_RATE_LIMIT=600
AUTH_IP_RATE_LIMIT=20
AUTH_ACCOUNT_RATE_LIMIT=10
REFRESH_RATE_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
MMRI_API_REPLICA_COUNT=1
MMRI_OPERATOR_USER_IDS=
MMRI_BILLING_PROVIDER=qpay
MMRI_BILLING_ENFORCEMENT=true
MMRI_DIAGNOSTIC_PRICE_MNT=300000
MMRI_RETAKE_PRICE_MNT=300000
MMRI_BILLING_CALLBACK_BASE_URL=https://mmri.example.com
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=REPLACE
QPAY_CLIENT_SECRET=REPLACE
QPAY_INVOICE_CODE=REPLACE
QPAY_REQUEST_TIMEOUT_MS=10000

# Temporary alternative before QPay: set MMRI_BILLING_PROVIDER=manual, configure
# MMRI_OPERATOR_EMAILS above, and fill at least one static QR field below.
MMRI_MANUAL_PAYMENT_QR_TEXT=
MMRI_MANUAL_PAYMENT_QR_IMAGE=
MMRI_MANUAL_PAYMENT_SHORT_URL=

# Persistent server-side report/PDF artifacts. Mount this path to durable storage.
MMRI_REPORT_STORAGE_DIR=/var/lib/mmri/report-storage

# AI report generation. Keep the real key only in the server secret environment.
MMRI_AI_REPORT_PROVIDER=openai
MMRI_AI_REPORT_REQUIRED=true
MMRI_AI_REPORT_MODEL=gpt-6.1-sol
MMRI_AI_REPORT_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_SECRET
