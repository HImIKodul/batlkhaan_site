# Step 6 display configuration only.
# Step 7 backend billing configuration must remain authoritative for charged amounts.
VITE_MMRI_DIAGNOSTIC_PRICE_MNT=300000
VITE_MMRI_CONTINUOUS_PRICE_MNT=

# Step 20 local full-stack integration
VITE_DEV_API_TARGET=http://127.0.0.1:4000
# Categories whose payment QR may be coloured, only after a real banking-app scan of that colour (marketing,it,finance,people,operations). Empty: black.
VITE_MMRI_COLOR_QR_AREAS=
