DATABASE_URL="postgresql://mmri:mmri@localhost:5432/mmri?schema=public"
NODE_ENV="development"
PORT=4000

# Canonical recovery methodology target. Historical assessments remain pinned to their stored version.
MMRI_TARGET_METHODOLOGY_VERSION="3.0.3"
MMRI_TARGET_QUESTION_BANK_VERSION="3.1.3"
MMRI_TARGET_QUESTION_BANK_ARRAY_SHA256="8d67f1e41fb05f5f92edd46ad8c21b8f696f7b5de315c573eba212bcca0fcc91"
MMRI_TARGET_METHODOLOGY_BUNDLE_SHA256="4ec42fb9fb7fd0d55c482bf5bbea379fb4cd3e9e97fd1921d405bbb432734c79"
MMRI_TARGET_METHODOLOGY_BUNDLE="methodology/MMRI_v3.0.3_QBANK_v3.1.3_STEP6_OF6_ACCEPTED_FINAL.json"
# Never enable candidate activation in production. These are only for a disposable PostgreSQL integration DB.
MMRI_ENVIRONMENT="development"
MMRI_INTEGRATION_RESET_OK="NO"
MMRI_INTEGRATION_ACTIVATE_CANDIDATE="NO"
ALLOWED_ORIGINS="http://localhost:5173"
ACCESS_TOKEN_ISSUER="mmri-api"
ACCESS_TOKEN_AUDIENCE="mmri-web"
ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
PASSWORD_PEPPER="replace-with-a-different-32-character-secret"
AUDIT_HASH_SALT="replace-with-another-32-character-random-secret"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME="mmri_refresh"
COOKIE_SECURE=false
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT_BYTES=1000000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
API_RATE_LIMIT=600
AUTH_IP_RATE_LIMIT=20
AUTH_ACCOUNT_RATE_LIMIT=10
REFRESH_RATE_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
MMRI_API_REPLICA_COUNT=1

# Internal governance operators only. Pilot-study management and methodology calibration
# endpoints are hidden from ordinary customer accounts. Leave empty to disable them.
# Production honours ONLY immutable account ids (e-mail ownership is not verified at registration).
MMRI_OPERATOR_USER_IDS=""
# Non-production convenience only; production startup refuses a non-empty value.
MMRI_OPERATOR_EMAILS=""

# Billing. Default diagnosis and retake price is 300,000 MNT unless overridden here.
MMRI_BILLING_PROVIDER="mock"
MMRI_BILLING_ENFORCEMENT=false
MMRI_DIAGNOSTIC_PRICE_MNT="300000"
MMRI_RETAKE_PRICE_MNT="300000"
MMRI_CONTINUOUS_PRICE_MNT=""
# For QPay sandbox/production callbacks this must be a publicly reachable HTTPS API origin.
MMRI_BILLING_CALLBACK_BASE_URL="http://127.0.0.1:4000"
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn"
QPAY_CLIENT_ID=""
QPAY_CLIENT_SECRET=""
QPAY_INVOICE_CODE=""
QPAY_REQUEST_TIMEOUT_MS=10000

# Optional temporary static/manual QR provider. Set MMRI_BILLING_PROVIDER="manual" and
# fill at least one QR field. Only MMRI_OPERATOR_USER_IDS can confirm a manual payment.
MMRI_MANUAL_PAYMENT_QR_TEXT=""
MMRI_MANUAL_PAYMENT_QR_IMAGE=""
MMRI_MANUAL_PAYMENT_SHORT_URL=""


# Step 10 — optional AI executive-report renderer.
# If disabled or unavailable, the deterministic validated report fallback is used.
# In production the endpoint is pinned to the official OpenAI Responses API.
# Keep OPENAI_API_KEY only in this server-side environment file / DigitalOcean secret; never in frontend code.
MMRI_AI_REPORT_PROVIDER="openai"
MMRI_AI_REPORT_REQUIRED=true
MMRI_AI_REPORT_MODEL="gpt-6.1-sol"
MMRI_AI_REPORT_ENDPOINT="https://api.openai.com/v1/responses"
MMRI_AI_REPORT_TIMEOUT_MS=45000
MMRI_AI_REPORT_TOTAL_TIMEOUT_MS=75000
MMRI_AI_REPORT_MAX_RETRIES=2
MMRI_AI_REPORT_RETRY_BASE_DELAY_MS=500
MMRI_AI_REPORT_RETRY_MAX_DELAY_MS=10000
MMRI_AI_REPORT_MAX_OUTPUT_TOKENS=8000
# After a provider-backed fallback, wait before another automatic upgrade attempt.
MMRI_AI_REPORT_RETRY_COOLDOWN_MS=300000
# Database lease prevents duplicate concurrent AI generation for the same report.
MMRI_AI_REPORT_GENERATION_LEASE_MS=300000
OPENAI_API_KEY=""

# Backend step 12 — official server-side PDF artifact generation.
# Keep this directory on persistent storage in production and include it in backups.
MMRI_REPORT_STORAGE_DIR="./report-storage"
MMRI_PDF_PYTHON_PATH="python3"
MMRI_PDF_RENDERER_SCRIPT="./pdf_renderer/render_report_pdf.py"
MMRI_PDF_RENDER_TIMEOUT_MS=45000

# Crash/restart recovery windows. Keep above normal provider request latency.
MMRI_BILLING_INTERRUPTED_INVOICE_RECOVERY_MS=300000
MMRI_ENTITLEMENT_ORPHAN_RECOVERY_MS=120000

# --- Password recovery e-mail (added 2026-11-05) ---
# mock     : development and tests only. Writes messages to backend/.mock-mailbox/outbox.jsonl. Forbidden in production.
# disabled : sends nothing (default in production). No real mail provider is implemented yet, so recovery e-mails are NOT delivered.
MMRI_MAIL_PROVIDER=mock
# Public https URL used in reset links, e.g. https://app.example.mn (defaults to the first ALLOWED_ORIGINS entry).
MMRI_PUBLIC_APP_URL=
MMRI_PASSWORD_RESET_TTL_MINUTES=30

# --- Admin Center / report review (added 2026-11-06) ---
# true: newly completed assessments need administrator approval before the customer sees the report (48 h target, never auto-approved).
MMRI_REPORT_REVIEW_REQUIRED=false
MMRI_ADMIN_SESSION_IDLE_MINUTES=30
MMRI_ADMIN_LOGIN_RATE_LIMIT=10
