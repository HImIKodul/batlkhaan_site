{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MMRI-QBANK-OVERLAY-1",
  "title": "MMRI human-reviewed question-bank wording overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "domainCode",
    "baseMethodologyVersion",
    "baseBundleSha256",
    "candidateMethodologyVersion",
    "candidateQuestionBankVersion",
    "categories",
    "questions"
  ],
  "properties": {
    "formatVersion": { "const": "MMRI-QBANK-OVERLAY-1" },
    "domainCode": { "enum": ["marketing", "it", "finance", "people", "operations"] },
    "baseMethodologyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "baseBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateMethodologyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "candidateQuestionBankVersion": { "type": "string", "minLength": 1 },
    "reviewedAtUtc": { "type": "string" },
    "reviewerNote": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "nameMn"],
        "properties": {
          "categoryId": { "type": "string", "minLength": 1 },
          "nameMn": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 12288,
      "maxItems": 12288,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "textMn", "options"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "textMn": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["optionIndex", "labelMn"],
              "properties": {
                "optionIndex": { "type": "integer", "minimum": 1 },
                "labelMn": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
