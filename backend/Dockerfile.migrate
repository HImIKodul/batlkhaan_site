FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
COPY methodology ./methodology
COPY tsconfig*.json ./
COPY src ./src
COPY scripts ./scripts
RUN npx prisma generate
# The migrate service mounts the report volume at the same path and, running first, initialises it: the
# directory must exist and be owned by the non-root user or the API cannot write reports later (MMRI-10).
RUN groupadd --system --gid 10001 mmri && useradd --system --uid 10001 --gid mmri --home /app mmri \
 && mkdir -p /var/lib/mmri/report-storage \
 && chown -R mmri:mmri /app /var/lib/mmri \
 && chmod 750 /var/lib/mmri/report-storage
USER mmri
CMD ["bash","-lc","npx prisma migrate deploy && npm run db:import && npm run db:verify"]
