  updatedAt                           DateTime         @updatedAt

  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  methodologyVersion     MethodologyVersion              @relation(fields: [methodologyVersionId], references: [id], onDelete: Restrict)
  createdBy              User?                           @relation("AssessmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  entitlement            CompanyEntitlement?             @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
