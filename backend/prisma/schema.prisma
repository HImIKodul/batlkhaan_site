  @@index([companyId, domainCode, createdAt])
  @@index([status, updatedAt])
  @@index([methodologyVersionId, status])
  @@index([createdByUserId, createdAt])
  @@index([entitlementId])
  @@index([parentAssessmentId])
  @@index([previousAssessmentId])
  @@map("assessments")
