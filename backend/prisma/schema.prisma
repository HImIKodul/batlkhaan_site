generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MethodologyStatus {
  DRAFT
  VALIDATING
  ACTIVE
  ARCHIVED
}

enum NaPolicy {
  CATEGORY_GATE
  CONDITIONAL
  DISALLOWED
}

enum SourceKind {
  SELF_REPORT
  RECENT_CASE
  RECORD_CHECK
  ADDITIONAL_CHECK
  RESERVE
  RESOLVER
}

enum AssessmentMode {
  QUICK
  FULL
}

enum AssessmentStatus {
  PROFILE_PENDING
  IN_PROGRESS
  PAUSED
  READY_FOR_COMPLETION
  PROCESSING
  COMPLETED
  COMPLETED_WITH_REVIEW
  EXHAUSTED
  CANCELLED
}

enum AnswerStatus {
  ANSWERED
  DNK
  N_A_CLAIM
  UNAVAILABLE
}

enum QuestionIssueStatus {
  ISSUED
  ANSWERED
  CANCELLED
}

enum AssessmentSnapshotKind {
  QUICK_RESULT
  FULL_RESULT
}

enum EvidenceSignalKind {
  PRIMARY
  SECONDARY
}

enum CellStateStatus {
  UNASSESSED
  GATHERING
  DIRECT_PROVISIONAL
  DERIVED_PROVISIONAL
  REVIEW_REQUIRED
  DIRECT_FINAL
  NOT_APPLICABLE
  UNRESOLVED
}

enum CellConfidenceState {
  UNASSESSED
  UNKNOWN
  ESTIMATED
  VALIDATED
  LOCKED
  NOT_APPLICABLE
}

enum ContradictionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyRole {
  OWNER
  ADMIN
  ASSESSOR
  CONSULTANT
  VIEWER
}

enum AuditEventType {
  ASSESSMENT_CREATED
  PROFILE_UPDATED
  QUESTION_ASKED
  QUESTION_ISSUED
  ANSWER_CREATED
  ANSWER_UPDATED
  EVIDENCE_CREATED
  EVIDENCE_RETRACTED
  CELL_UPDATED
  CELL_FINALIZED
  CELL_LOCKED
  CELL_REOPENED
  CELL_UNLOCKED
  CONTRADICTION_FOUND
  CONTRADICTION_RESOLVED
  ASSESSMENT_COMPLETED
  REPORT_GENERATED
  STRATEGY_GENERATED
  ACTION_PLAN_GENERATED
  REPORT_VALIDATED
  REPORT_GENERATION_STARTED
  REPORT_GENERATION_FAILED
  REPORT_GENERATION_FALLBACK
  STRATEGY_FROZEN
  ACTION_PLAN_FROZEN
  ACTION_PLAN_MILESTONE_STATUS_CHANGED
  ACTION_PLAN_MILESTONE_TRACKING_UPDATED
  ASSESSMENT_PAUSED
  ASSESSMENT_RESUMED
  WRITER_LEASE_ACQUIRED
  WRITER_LEASE_RENEWED
  DRAFT_SAVED
  ANSWER_EVENT_APPENDED
  STATE_SNAPSHOT_FROZEN
  DIAGNOSIS_FROZEN
  TRACE_GRAPH_FROZEN
  TRACE_GRAPH_VERIFIED
  REPORT_PUBLICATION_BLOCKED
}

enum RecommendationType {
  EXECUTION
  LOCAL_IMPROVEMENT
  VALIDATE_CAUSE
  COLLECT_EVIDENCE
  RESOLVE_EVIDENCE
}

enum PriorityBand {
  P1
  P2
  P3
  P4
}

enum PlanMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum ReportGenerationState {
  PAYLOAD_FROZEN
  PASS
  REPAIR_REQUIRED
  GENERATION_BLOCKED
  AI_FALLBACK_USED
}

enum BillingPlanCode {
  DIAGNOSTIC
  RETAKE
  CONTINUOUS
}

enum PaymentProvider {
  QPAY
  MOCK
  MANUAL
}

enum BillingInvoiceStatus {
  CREATED
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum PilotStudyStatus {
  DRAFT
  RECRUITING
  ACTIVE
  ANALYSIS
  READY_FOR_REVIEW
  CLOSED
}

enum PilotConsentStatus {
  PENDING
  CONSENTED
  DECLINED
  WITHDRAWN
}

enum PilotAssessmentRole {
  COGNITIVE
  BASELINE
  SECOND_RATER
  RETEST
}

enum PilotFeedbackDimension {
  CLARITY
  BURDEN
  DIAGNOSIS_USEFULNESS
  RECOMMENDATION_USEFULNESS
}

enum PilotGateDecisionStatus {
  APPROVE
  REVISE
  HOLD
}

enum CalibrationProposalStatus {
  DRAFT
  SUBMITTED
  REVISE_REQUIRED
  APPROVED
  REJECTED
  ACTIVATED
  WITHDRAWN
}

enum CalibrationChangeKind {
  CONTRIBUTION_STRENGTH
  CONFIDENCE_EVIDENCE_UNIT
  ADAPTIVE_ROUTING_COEFFICIENT
  STOP_THRESHOLD
  INFORMATION_VALUE_PRIOR
  PROFILE_FIT_MULTIPLIER
  UNCERTAINTY_BAND
  QUESTION_WORDING
  QUESTION_MAPPING
  CATEGORY_WEIGHT
  CELL_WEIGHT
  SCORING_RULE
  OTHER_SEMANTIC
}

enum CalibrationReviewDecision {
  APPROVE
  REVISE
  REJECT
}

model MethodologyVersion {
  id                String            @id
  domainCode        String            @default("marketing")
  version           String            @unique
  bundleVersion     String
  sourceMethodology String
  bundleSha256      String            @unique
  status            MethodologyStatus @default(DRAFT)
  validation        Json
  generatedAtUtc    DateTime?
  createdAt         DateTime          @default(now())
  activatedAt       DateTime?

  modules                        Module[]
  categories                     Category[]
  cellTemplates                  CellTemplate[]
  diagnosticCells                DiagnosticCell[]
  questions                      Question[]
  profileQuestions               ProfileQuestion[]
  scoringProfiles                ScoringProfile[]
  contracts                      MethodologyContract[]
  manifestEntries                SourceManifestEntry[]
  respondentRoles                RespondentRole[]
  purposes                       PurposeDefinition[]
  categoryDependencies           CategoryDependency[]
  cellDependencies               CellDependency[]
  importRuns                     ImportRun[]
  assessments                    Assessment[]
  pilotStudies                   PilotStudy[]
  sourceCalibrationProposals     CalibrationProposal[]   @relation("CalibrationSourceMethodology")
  candidateCalibrationProposals  CalibrationProposal[]   @relation("CalibrationCandidateMethodology")
  calibrationReleasesAsSource    CalibrationRelease[]    @relation("CalibrationReleaseSource")
  calibrationReleasesAsCandidate CalibrationRelease[]    @relation("CalibrationReleaseCandidate")
  questionRuntimePolicies        QuestionRuntimePolicy[]
  cellRuntimePolicies            CellRuntimePolicy[]
  runtimeRuleDefinitions         RuntimeRuleDefinition[]
  runtimeScorePatterns           RuntimeScorePattern[]

  @@map("methodology_versions")
}

model Module {
  id                   String  @id
  methodologyVersionId String
  code                 String
  nameMn               String
  weightPct            Decimal @db.Decimal(8, 4)
  orderIndex           Int

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  categories         Category[]
  moduleResults      ModuleResult[]

  @@unique([methodologyVersionId, code])
  @@unique([methodologyVersionId, nameMn])
  @@index([methodologyVersionId, orderIndex])
  @@map("modules")
}

model Category {
  id                   String  @id
  methodologyVersionId String
  moduleId             String
  externalId           String
  nameMn               String
  moduleWeightPct      Decimal @db.Decimal(8, 4)
  categoryWeightPct    Decimal @db.Decimal(8, 4)
  orderIndex           Int

  methodologyVersion     MethodologyVersion              @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  module                 Module                          @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  diagnosticCells        DiagnosticCell[]
  questions              Question[]
  purposeMappings        CategoryPurposeMapping[]
  prerequisiteEdges      CategoryDependency[]            @relation("CategoryDependencyPrerequisite")
  dependentEdges         CategoryDependency[]            @relation("CategoryDependencyDependent")
  categoryResults        CategoryResult[]
  outcomePriorityResults CategoryOutcomePriorityResult[]
  rootFindings           RootFindingRecord[]
  recommendations        RecommendationRecord[]

  @@unique([methodologyVersionId, externalId])
  @@index([methodologyVersionId, moduleId])
  @@map("categories")
}

model CellTemplate {
  id                   String   @id
  methodologyVersionId String
  externalId           String
  nameMn               String
  groupMn              String
  roleMn               String
  weightPct            Decimal  @db.Decimal(8, 4)
  naPolicy             NaPolicy
  sourceNaEligibility  String
  orderIndex           Int

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  diagnosticCells    DiagnosticCell[]

  @@unique([methodologyVersionId, externalId])
  @@index([methodologyVersionId, orderIndex])
  @@map("cell_templates")
}

model DiagnosticCell {
  id                                   String   @id
  weightPctOverride                    Decimal? @db.Decimal(12, 8)
  methodologyVersionId                 String
  categoryId                           String
  cellTemplateId                       String
  externalId                           String
  directQuestionCount                  Int
  independentSourceKinds               Int
  minThreePathConfidenceAtAuthority075 Decimal  @db.Decimal(8, 6)
  preferredRoleCode                    String
  preferredAuthority                   Decimal  @db.Decimal(6, 4)
  coverageStatus                       String

  methodologyVersion MethodologyVersion        @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cellTemplate       CellTemplate              @relation(fields: [cellTemplateId], references: [id], onDelete: Restrict)
  questions          Question[]
  authorityRouting   AuthorityRouting?
  incomingSecondary  QuestionSecondaryTarget[] @relation("SecondaryTargetCell")
  outgoingCellDeps   CellDependency[]          @relation("CellDependencyPrerequisite")
  incomingCellDeps   CellDependency[]          @relation("CellDependencyDependent")
  cellStates         AssessmentCellState[]
  evidenceSignals    EvidenceSignal[]
  contradictions     Contradiction[]
  rootFindings       RootFindingRecord[]
  recommendations    RecommendationRecord[]
  runtimePolicy      CellRuntimePolicy?

  @@unique([methodologyVersionId, externalId])
  @@unique([categoryId, cellTemplateId])
  @@index([methodologyVersionId, categoryId])
  @@index([cellTemplateId])
  @@map("diagnostic_cells")
}

model Question {
  id                   String     @id
  methodologyVersionId String
  categoryId           String
  primaryCellId        String
  externalId           String
  sourceRow            Int
  path                 Int
  sourceKind           SourceKind
  textMn               String     @db.Text
  primaryCoefficient   Decimal    @db.Decimal(6, 4)
  scoringProfileCode   String?
  optionSetHash        String

  methodologyVersion MethodologyVersion        @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primaryCell        DiagnosticCell            @relation(fields: [primaryCellId], references: [id], onDelete: Cascade)
  options            QuestionOption[]
  secondaryTargets   QuestionSecondaryTarget[]
  answers            Answer[]
  askedQuestions     AssessmentAskedQuestion[]
  answerEvents       AnswerEvent[]
  responseDrafts     ResponseDraft[]
  runtimePolicy      QuestionRuntimePolicy?

  @@unique([methodologyVersionId, externalId])
  @@unique([methodologyVersionId, sourceRow])
  @@index([primaryCellId, path])
  @@index([categoryId])
  @@map("questions")
}

model QuestionOption {
  id          String   @id
  questionId  String
  optionIndex Int
  labelMn     String   @db.Text
  score       Decimal? @db.Decimal(8, 4)
  state       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionIndex])
  @@map("question_options")
}

model QuestionSecondaryTarget {
  id           String  @id
  questionId   String
  targetCellId String
  coefficient  Decimal @db.Decimal(6, 4)
  relationCode String

  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  targetCell DiagnosticCell @relation("SecondaryTargetCell", fields: [targetCellId], references: [id], onDelete: Cascade)

  @@unique([questionId, targetCellId, relationCode], map: "question_secondary_targets_questionId_targetCellId_relationCode")
  @@index([targetCellId])
  @@map("question_secondary_targets")
}

model QuestionRuntimePolicy {
  id                   String   @id @default(cuid())
  methodologyVersionId String
  questionId           String   @unique
  questionRole         String
  scoreEligible        Boolean
  scoringMethod        String
  scoredOptionCount    Int
  scorePatternCode     String
  directAskAllowed     Boolean  @default(true)
  routingState         String   @default("DIRECT_ALLOWED")
  askStage             String
  selectionPriority    Int
  isAnchor             Boolean  @default(false)
  applicabilityGateKey String
  triggerRuleId        String
  confidenceRuleId     String
  defaultAsk           Boolean  @default(false)
  stopRuleId           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  question           Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([methodologyVersionId, askStage, selectionPriority], map: "question_runtime_policies_methodologyVersionId_askStage_selecti")
  @@index([methodologyVersionId, applicabilityGateKey], map: "question_runtime_policies_methodologyVersionId_applicabilityGat")
  @@map("question_runtime_policies")
}

model CellRuntimePolicy {
  id                     String   @id @default(cuid())
  methodologyVersionId   String
  diagnosticCellId       String   @unique
  applicabilityMode      String
  applicabilityGateKey   String
  isAnchorCell           Boolean  @default(false)
  directAskableQuestions Int
  maxDirectQuestions     Int
  indirectConfidenceCap  Decimal  @db.Decimal(8, 6)
  primaryConfidenceFloor Decimal  @db.Decimal(8, 6)
  lockThreshold          Decimal  @db.Decimal(8, 6)
  conflictGapThreshold   Decimal  @db.Decimal(8, 4)
  stateModelId           String
  valueRuleId            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  diagnosticCell     DiagnosticCell     @relation(fields: [diagnosticCellId], references: [id], onDelete: Cascade)

  @@index([methodologyVersionId, applicabilityMode], map: "cell_runtime_policies_methodologyVersionId_applicabilityMode_id")
  @@index([methodologyVersionId, applicabilityGateKey], map: "cell_runtime_policies_methodologyVersionId_applicabilityGateKey")
  @@map("cell_runtime_policies")
}

model RuntimeRuleDefinition {
  id                   String   @id @default(cuid())
  methodologyVersionId String
  ruleId               String
  ruleType             String
  definition           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, ruleId])
  @@index([methodologyVersionId, ruleType])
  @@map("runtime_rule_definitions")
}

model RuntimeScorePattern {
  id                   String   @id @default(cuid())
  methodologyVersionId String
  code                 String
  scoreEligible        Boolean
  scoredOptionCount    Int
  optionScores         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, code])
  @@map("runtime_score_patterns")
}

model ProfileQuestion {
  id                   String  @id
  methodologyVersionId String
  externalId           String
  textMn               String  @db.Text
  questionType         String?
  orderIndex           Int

  methodologyVersion MethodologyVersion      @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  options            ProfileQuestionOption[]

  @@unique([methodologyVersionId, externalId])
  @@map("profile_questions")
}

model ProfileQuestionOption {
  id                String @id
  profileQuestionId String
  optionIndex       Int
  labelMn           String @db.Text

  profileQuestion ProfileQuestion @relation(fields: [profileQuestionId], references: [id], onDelete: Cascade)

  @@unique([profileQuestionId, optionIndex])
  @@map("profile_question_options")
}

model ScoringProfile {
  id                   String @id
  methodologyVersionId String
  code                 String
  definition           Json

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, code])
  @@map("scoring_profiles")
}

model MethodologyContract {
  id                   String  @id
  methodologyVersionId String
  sourceName           String
  contractVersion      String
  sha256               String?
  definition           Json

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, sourceName])
  @@map("methodology_contracts")
}

model SourceManifestEntry {
  id                   String @id
  methodologyVersionId String
  sourceName           String
  sourceVersion        String
  sha256               String
  chunkCount           Int
  sizeValue            Int
  role                 String

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, sourceName])
  @@map("source_manifest_entries")
}

model RespondentRole {
  id                   String @id
  methodologyVersionId String
  externalId           String
  code                 String
  labelMn              String
  scopeMn              String

  methodologyVersion    MethodologyVersion     @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  preferredFor          AuthorityRouting[]
  assessmentRespondents AssessmentRespondent[]

  @@unique([methodologyVersionId, externalId])
  @@unique([methodologyVersionId, code])
  @@map("respondent_roles")
}

model AuthorityRouting {
  id                 String  @id
  diagnosticCellId   String  @unique
  preferredRoleId    String
  preferredAuthority Decimal @db.Decimal(6, 4)
  backupRoles        Json

  diagnosticCell DiagnosticCell @relation(fields: [diagnosticCellId], references: [id], onDelete: Cascade)
  preferredRole  RespondentRole @relation(fields: [preferredRoleId], references: [id], onDelete: Restrict)

  @@index([preferredRoleId])
  @@map("authority_routing")
}

model PurposeDefinition {
  id                   String @id
  methodologyVersionId String
  externalId           String
  code                 String
  labelMn              String
  orderIndex           Int

  methodologyVersion     MethodologyVersion              @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  categoryMappings       CategoryPurposeMapping[]
  purposeResults         PurposeResult[]
  outcomePriorityResults CategoryOutcomePriorityResult[]

  @@unique([methodologyVersionId, externalId])
  @@unique([methodologyVersionId, code])
  @@map("purpose_definitions")
}

model CategoryPurposeMapping {
  id          String  @id
  categoryId  String
  purposeId   String
  coefficient Decimal @db.Decimal(6, 4)
  rationale   String? @db.Text

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  purpose  PurposeDefinition @relation(fields: [purposeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, purposeId])
  @@index([purposeId])
  @@map("category_purpose_mappings")
}

model CategoryDependency {
  id                     String  @id
  methodologyVersionId   String
  externalId             String
  prerequisiteCategoryId String
  dependentCategoryId    String
  strength               Decimal @db.Decimal(6, 4)
  dependencyType         String
  rationale              String  @db.Text

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  prerequisite       Category           @relation("CategoryDependencyPrerequisite", fields: [prerequisiteCategoryId], references: [id], onDelete: Cascade)
  dependent          Category           @relation("CategoryDependencyDependent", fields: [dependentCategoryId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, externalId])
  @@index([prerequisiteCategoryId])
  @@index([dependentCategoryId])
  @@map("category_dependencies")
}

model CellDependency {
  id                   String  @id
  methodologyVersionId String
  externalId           String
  prerequisiteCellId   String
  dependentCellId      String
  strength             Decimal @db.Decimal(6, 4)
  dependencyType       String
  rationale            String  @db.Text

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  prerequisite       DiagnosticCell     @relation("CellDependencyPrerequisite", fields: [prerequisiteCellId], references: [id], onDelete: Cascade)
  dependent          DiagnosticCell     @relation("CellDependencyDependent", fields: [dependentCellId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, externalId, prerequisiteCellId], map: "cell_dependencies_methodologyVersionId_externalId_prerequisiteC")
  @@index([prerequisiteCellId])
  @@index([dependentCellId])
  @@map("cell_dependencies")
}

model ImportRun {
  id                   String    @id @default(cuid())
  methodologyVersionId String
  bundleSha256         String
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  status               String
  counts               Json?
  errorMessage         String?   @db.Text

  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@index([methodologyVersionId, startedAt])
  @@map("import_runs")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  displayName  String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(1)
  lastLoginAt  DateTime?
  /// Set when the account was erased at the user's request (personal data removed; payment/audit rows are retained, see docs/DATA_LIFECYCLE.md).
  erasedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships                  CompanyMembership[]
  refreshSessions              RefreshSession[]
  passwordResetTokens          PasswordResetToken[]
  authEvents                   AuthAuditEvent[]
  assessmentsCreated           Assessment[]          @relation("AssessmentCreator")
  billingInvoicesCreated       BillingInvoice[]      @relation("BillingInvoiceCreator")
  pilotStudiesCreated          PilotStudy[]          @relation("PilotStudyCreator")
  pilotGateDecisions           PilotGateDecision[]   @relation("PilotGateReviewer")
  calibrationProposalsCreated  CalibrationProposal[] @relation("CalibrationProposalCreator")
  calibrationProposalsToReview CalibrationProposal[] @relation("CalibrationProposalReviewer")
  calibrationReviews           CalibrationReview[]   @relation("CalibrationReviewer")
  calibrationReleasesActivated CalibrationRelease[]  @relation("CalibrationReleaseActivator")
  adminAccount                 AdminAccount?
  paymentDisputeEvents         PaymentDisputeEvent[]
  paymentDisputes              PaymentDispute[]
  supportCaseEvents            SupportCaseEvent[]
  supportCases                 SupportCase[]

  @@index([status])
  @@map("users")
}

model CompanyMembership {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, role])
  @@index([companyId, role])
  @@index([companyId, role, userId], map: "company_memberships_company_role_user_idx")
  @@map("company_memberships")
}

/// One-time password reset tokens. Only a hash of the token is stored; the token itself exists only in the e-mail link.
model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  requestIpHash String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedAt     DateTime?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model AuthAuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  eventType     String
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("auth_audit_events")
}

model Company {
  id              String    @id @default(cuid())
  name            String
  industry        String?
  businessModel   String?
  employeeCount   Int?
  companyAgeYears Decimal?  @db.Decimal(8, 2)
  marketType      String?
  country         String?
  profile         Json?
  /// Set when customer content was erased at the owner's request. The row stays as an anonymised shell so retained invoices keep a valid parent.
  erasedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships      CompanyMembership[]
  assessments      Assessment[]
  billingInvoices  BillingInvoice[]
  entitlements     CompanyEntitlement[]
  pilotEnrollments PilotEnrollment[]
  paymentDisputes  PaymentDispute[]
  reportReviews    ReportReview[]
  supportCases     SupportCase[]

  @@map("companies")
}

model BillingInvoice {
  id                 String               @id @default(cuid())
  domainCode         String               @default("marketing")
  companyId          String
  createdByUserId    String
  planCode           BillingPlanCode
  amountMnt          Int
  currency           String               @default("MNT")
