  qrImage            String?              @db.Text
  shortUrl           String?              @db.Text
  deeplinks          Json?
  providerMetadata   Json?
  callbackReceivedAt DateTime?
  lastVerifiedAt     DateTime?
  paidAt             DateTime?
  refundedAt         DateTime?
  refundReference    String?
  // Uniqueness is enforced by a PARTIAL unique index (billing_invoices_refundReference_key ... WHERE "refundReference" IS NOT NULL, migration
  // 20261025051000). Prisma cannot express partial indexes, so it is intentionally not declared here; look invoices up with findFirst.
  refundReason       String?              @db.Text
  failureReason      String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
