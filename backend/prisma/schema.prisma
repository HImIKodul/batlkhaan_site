model ReportSnapshot {
  id                       String                @id @default(cuid())
  assessmentId             String
  externalId               String
  reportContractVersion    String
  aiContractVersion        String
  payloadHash              String                @unique
  diagnosisResultHash      String?
  strategyHash             String?
  planHash                 String?
  bindingHash              String?
  payload                  Json
  narrative                Json?
  narrativeHash            String?               @unique
  validation               Json?
  modelIdentifier          String?
  modelConfig              Json?
  promptVersion            String?
  validatorVersion         String?
  generationAttemptCount   Int                   @default(0)
  providerHttpAttemptCount Int                   @default(0)
  providerRetryCount       Int                   @default(0)
  providerRequestIds       Json?
  providerError            String?
  nextAiRetryAt            DateTime?
  generationLeaseId        String?
  generationLeaseExpiresAt DateTime?
  generationStartedAt      DateTime?
  generationCompletedAt    DateTime?
  generationFailureCount   Int                   @default(0)
  sourceSnapshotId         String?
  sourceSnapshotHash       String?
  versionBundleId          String?
  versionBundleHash        String?
  traceVersion             String?
  traceGraphHash           String?
  generationState          ReportGenerationState @default(PAYLOAD_FROZEN)
  generatedAt              DateTime              @default(now())
  publishedAt              DateTime?

  assessment     Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sourceSnapshot AssessmentStateSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  traceSnapshots TraceSnapshot[]
  artifacts      ReportArtifact[]

  @@unique([assessmentId, externalId])
  @@index([assessmentId, generatedAt])
  @@index([diagnosisResultHash])
  @@index([strategyHash])
  @@index([planHash])
  @@index([bindingHash])
  @@index([generationLeaseExpiresAt])
  @@index([nextAiRetryAt])
  @@index([sourceSnapshotId])
  @@index([sourceSnapshotHash])
  @@index([traceGraphHash])
  @@map("report_snapshots")
}

model TraceSnapshot {
  id                 String   @id @default(cuid())
  assessmentId       String
  externalId         String
  traceVersion       String
  sourceSnapshotId   String
  sourceSnapshotHash String
  versionBundleId    String
  versionBundleHash  String
  graphHash          String   @unique
  graph              Json
  publicationStatus  String
  reportSnapshotId   String?
  createdAt          DateTime @default(now())

  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reportSnapshot ReportSnapshot? @relation(fields: [reportSnapshotId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, externalId])
  @@index([assessmentId, createdAt])
  @@index([sourceSnapshotHash])
  @@index([reportSnapshotId])
  @@map("trace_snapshots")
}

model PilotStudy {
  id                   String           @id @default(cuid())
  code                 String           @unique
  title                String
  methodologyVersionId String
  status               PilotStudyStatus @default(DRAFT)
  targetCompanies      Int              @default(30)
  cognitiveTarget      Int              @default(8)
  fieldTarget          Int              @default(20)
  retestTarget         Int              @default(8)
  retestMinDays        Int              @default(7)
  retestMaxDays        Int              @default(14)
  createdByUserId      String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  closedAt             DateTime?

  methodologyVersion   MethodologyVersion    @relation(fields: [methodologyVersionId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation("PilotStudyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  enrollments          PilotEnrollment[]
  analysisRuns         PilotAnalysisRun[]
  gateDecisions        PilotGateDecision[]
  calibrationProposals CalibrationProposal[]

  @@index([status, createdAt])
  @@index([methodologyVersionId])
  @@map("pilot_studies")
}

model PilotEnrollment {
  id               String             @id @default(cuid())
  studyId          String
  companyId        String
  deidentifiedCode String
  consentStatus    PilotConsentStatus @default(PENDING)
  consentedAt      DateTime?
  withdrawnAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  study    PilotStudy            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  links    PilotAssessmentLink[]
  feedback PilotFeedback[]
  baseline PilotOutcomeBaseline?

  @@unique([studyId, companyId])
  @@unique([studyId, deidentifiedCode])
  @@index([studyId, consentStatus])
  @@map("pilot_enrollments")
}

model PilotAssessmentLink {
  id           String              @id @default(cuid())
  enrollmentId String
  assessmentId String              @unique
  role         PilotAssessmentRole
  pairKey      String?
  linkedAt     DateTime            @default(now())

  enrollment PilotEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, role])
  @@index([enrollmentId, role])
  @@index([pairKey])
  @@map("pilot_assessment_links")
}

model PilotFeedback {
  id                 String                 @id @default(cuid())
  enrollmentId       String
  assessmentId       String?
  questionExternalId String?
  dimension          PilotFeedbackDimension
  rating             Int
  commentText        String?                @db.Text
  createdAt          DateTime               @default(now())

  enrollment PilotEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessment Assessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, dimension])
  @@index([assessmentId, dimension])
  @@map("pilot_feedback")
}

model PilotOutcomeBaseline {
  id              String   @id @default(cuid())
  enrollmentId    String   @unique
  revenueBand     String?
  profitBand      String?
  customerBand    String?
  marketShareBand String?
  brandIndexBand  String?
  recordedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollment PilotEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("pilot_outcome_baselines")
}

model PilotAnalysisRun {
  id          String   @id @default(cuid())
  studyId     String
  inputSha256 String
  metrics     Json
  gates       Json
  createdAt   DateTime @default(now())

  study                PilotStudy            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  decisions            PilotGateDecision[]
  calibrationProposals CalibrationProposal[]

  @@index([studyId, createdAt])
  @@index([inputSha256])
  @@map("pilot_analysis_runs")
}

model PilotGateDecision {
  id             String                  @id @default(cuid())
  studyId        String
  analysisRunId  String
  reviewerUserId String
  status         PilotGateDecisionStatus
  rationale      String                  @db.Text
  createdAt      DateTime                @default(now())

  study                PilotStudy            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  analysisRun          PilotAnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  reviewer             User                  @relation("PilotGateReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  calibrationProposals CalibrationProposal[]

  @@index([studyId, createdAt])
  @@index([analysisRunId])
  @@map("pilot_gate_decisions")
}

model CalibrationProposal {
  id                            String                    @id @default(cuid())
  studyId                       String
  analysisRunId                 String
  pilotDecisionId               String
  sourceMethodologyVersionId    String
  candidateMethodologyVersionId String?                   @unique
  proposedVersion               String                    @unique
  title                         String
  summary                       String                    @db.Text
  evidenceSha256                String                    @unique
  candidateBundleSha256         String?                   @unique
  status                        CalibrationProposalStatus @default(DRAFT)
  createdByUserId               String
  reviewerUserId                String
  createdAt                     DateTime                  @default(now())
  submittedAt                   DateTime?
  approvedAt                    DateTime?
  activatedAt                   DateTime?

  study                PilotStudy          @relation(fields: [studyId], references: [id], onDelete: Restrict)
  analysisRun          PilotAnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  pilotDecision        PilotGateDecision   @relation(fields: [pilotDecisionId], references: [id], onDelete: Restrict)
  sourceMethodology    MethodologyVersion  @relation("CalibrationSourceMethodology", fields: [sourceMethodologyVersionId], references: [id], onDelete: Restrict)
  candidateMethodology MethodologyVersion? @relation("CalibrationCandidateMethodology", fields: [candidateMethodologyVersionId], references: [id], onDelete: Restrict)
  createdBy            User                @relation("CalibrationProposalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewer             User                @relation("CalibrationProposalReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  changes              CalibrationChange[]
  reviews              CalibrationReview[]
  release              CalibrationRelease?

  @@index([studyId, createdAt])
  @@index([sourceMethodologyVersionId, status])
  @@index([reviewerUserId, status])
  @@map("calibration_proposals")
}

model CalibrationChange {
  id              String                @id @default(cuid())
  proposalId      String
  orderIndex      Int
  kind            CalibrationChangeKind
  sourcePath      String
  beforeValue     Json
  proposedValue   Json
  rationale       String                @db.Text
  evidenceGateIds Json
  createdAt       DateTime              @default(now())

  proposal CalibrationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, orderIndex])
  @@index([proposalId, kind])
  @@map("calibration_changes")
}

model CalibrationReview {
  id             String                    @id @default(cuid())
  proposalId     String
  reviewerUserId String
  decision       CalibrationReviewDecision
  rationale      String                    @db.Text
  createdAt      DateTime                  @default(now())

  proposal CalibrationProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  reviewer User                @relation("CalibrationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
  @@index([reviewerUserId, createdAt])
  @@map("calibration_reviews")
}

model CalibrationRelease {
  id                            String   @id @default(cuid())
  proposalId                    String   @unique
  sourceMethodologyVersionId    String
  candidateMethodologyVersionId String   @unique
  activatedByUserId             String
  releaseSha256                 String   @unique
  activatedAt                   DateTime @default(now())

  proposal             CalibrationProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  sourceMethodology    MethodologyVersion  @relation("CalibrationReleaseSource", fields: [sourceMethodologyVersionId], references: [id], onDelete: Restrict)
  candidateMethodology MethodologyVersion  @relation("CalibrationReleaseCandidate", fields: [candidateMethodologyVersionId], references: [id], onDelete: Restrict)
  activatedBy          User                @relation("CalibrationReleaseActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict)

  @@index([activatedAt])
  @@map("calibration_releases")
}

// ===== Admin system (migration 20261106100000_admin_system). References to existing tables are plain FK columns enforced in SQL. =====
model AdminAccount {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  role                    String
  status                  String                   @default("PENDING_MFA")
  mfaSecretEnc            String?
  mfaLastStep             BigInt                   @default(0)
  failedLogins            Int                      @default(0)
  lockedUntil             DateTime?
  createdByAdminId        String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  disabledAt              DateTime?
  user                    User                     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  notificationReads       AdminNotificationRead[]
  sessions                AdminSession[]
  paymentDisputeEvents    PaymentDisputeEvent[]
  paymentDisputes         PaymentDispute[]
  reportReviewRevisions   ReportReviewRevision[]
  reportReviewSuggestions ReportReviewSuggestion[]
  approvedReviews         ReportReview[]           @relation("report_reviews_approvedByAdminIdToadmin_accounts")
  assignedReviews         ReportReview[]           @relation("report_reviews_assignedAdminIdToadmin_accounts")
  publishedReviews        ReportReview[]           @relation("report_reviews_publishedByAdminIdToadmin_accounts")
  supportCaseEvents       SupportCaseEvent[]
  supportCases            SupportCase[]
  grantedEntitlements     CompanyEntitlement[]     @relation("EntitlementGrantedBy")
  revokedEntitlements     CompanyEntitlement[]     @relation("EntitlementRevokedBy")

  @@map("admin_accounts")
}

model AdminSession {
  id                String       @id @default(cuid())
  adminId           String
  tokenHash         String       @unique
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  reauthAt          DateTime?
  revokedAt         DateTime?
  ipHash            String?
  userAgentHash     String?
  admin             AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([adminId])
  @@map("admin_sessions")
}

model ReportReview {
  id                    String                   @id @default(cuid())
  assessmentId          String                   @unique
  companyId             String
  domainCode            String
  status                String
  submittedAt           DateTime
  deadlineAt            DateTime
  draftGeneratedAt      DateTime?
  assignedAdminId       String?
  currentRevision       Int                      @default(0)
  approvedAt            DateTime?
  approvedByAdminId     String?
  publishedAt           DateTime?
  publishedByAdminId    String?
  publishedRevision     Int?
  remindersSent         Json                     @default("{}")
  lastError             String?
  version               Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @default(now()) @updatedAt
  approvedRevision      Int?
  approvedNarrativeHash String?
  revisions             ReportReviewRevision[]
  suggestions           ReportReviewSuggestion[]
  approvedBy            AdminAccount?            @relation("report_reviews_approvedByAdminIdToadmin_accounts", fields: [approvedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment            Assessment               @relation(fields: [assessmentId], references: [id], onUpdate: NoAction)
  assignedAdmin         AdminAccount?            @relation("report_reviews_assignedAdminIdToadmin_accounts", fields: [assignedAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company               Company                  @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  publishedBy           AdminAccount?            @relation("report_reviews_publishedByAdminIdToadmin_accounts", fields: [publishedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId], map: "report_reviews_company_idx")
  @@index([status, deadlineAt], map: "report_reviews_status_deadline_idx")
  @@map("report_reviews")
}

model ReportReviewRevision {
  id               String        @id @default(cuid())
  reviewId         String
  revision         Int
  narrative        Json
  source           String
  reason           String?
  changedClaims    Json          @default("[]")
  createdByAdminId String?
  createdAt        DateTime      @default(now())
  createdByAdmin   AdminAccount? @relation(fields: [createdByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review           ReportReview  @relation(fields: [reviewId], references: [id], onUpdate: NoAction)

  @@unique([reviewId, revision])
  @@map("report_review_revisions")
}

model ReportReviewSuggestion {
  id               String        @id @default(cuid())
  reviewId         String
  revision         Int
  claimId          String
  original         String
  suggested        String
  reason           String
  evidence         Json          @default("[]")
  warning          String        @default("NONE")
  source           String        @default("MOCK")
  status           String        @default("PROPOSED")
  decidedByAdminId String?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())
  decidedByAdmin   AdminAccount? @relation(fields: [decidedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review           ReportReview  @relation(fields: [reviewId], references: [id], onUpdate: NoAction)

  @@index([reviewId, status], map: "report_review_suggestions_review_idx")
  @@map("report_review_suggestions")
}

model AdminNotification {
  id         String                  @id @default(cuid())
  type       String
  dedupeKey  String                  @unique
  targetType String
  targetId   String
  severity   String                  @default("INFO")
  title      String
  body       String
  createdAt  DateTime                @default(now())
  reads      AdminNotificationRead[]

  @@index([createdAt(sort: Desc)], map: "admin_notifications_created_idx")
  @@map("admin_notifications")
}

model AdminNotificationRead {
  adminId        String
  notificationId String
  readAt         DateTime          @default(now())
  admin          AdminAccount      @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([adminId, notificationId])
  @@map("admin_notification_reads")
}

model PaymentDispute {
  id               String                @id @default(cuid())
  invoiceId        String
  companyId        String
  status           String                @default("OPEN")
  category         String                @default("GENERAL")
  summary          String
  openedByUserId   String?
  assignedAdminId  String?
  refundApprovedAt DateTime?
  refundExecutedAt DateTime?
  resolution       String?
  version          Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  events           PaymentDisputeEvent[]
  assignedAdmin    AdminAccount?         @relation(fields: [assignedAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company          Company               @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  invoice          BillingInvoice        @relation(fields: [invoiceId], references: [id], onUpdate: NoAction)
  openedBy         User?                 @relation(fields: [openedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt], map: "payment_disputes_status_idx")
  @@map("payment_disputes")
}

model PaymentDisputeEvent {
  id        String         @id @default(cuid())
  disputeId String
  adminId   String?
  userId    String?
  kind      String
  body      String
  createdAt DateTime       @default(now())
  admin     AdminAccount?  @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispute   PaymentDispute @relation(fields: [disputeId], references: [id], onUpdate: NoAction)
  user      User?          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payment_dispute_events")
}

model SupportCase {
  id              String             @id @default(cuid())
  companyId       String?
  userId          String?
  category        String
  priority        String             @default("NORMAL")
  status          String             @default("OPEN")
  subject         String
  assignedAdminId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  events          SupportCaseEvent[]
  assignedAdmin   AdminAccount?      @relation(fields: [assignedAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user            User?              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, createdAt], map: "support_cases_status_idx")
  @@map("support_cases")
}

model SupportCaseEvent {
  id          String        @id @default(cuid())
  caseId      String
  adminId     String?
  userId      String?
  kind        String
  body        String
  createdAt   DateTime      @default(now())
  admin       AdminAccount? @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supportCase SupportCase   @relation(fields: [caseId], references: [id], onUpdate: NoAction)
  user        User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("support_case_events")
}

model AdminAuditEvent {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  outcome    String
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)], map: "admin_audit_events_created_idx")
  @@index([adminId, createdAt], map: "admin_audit_events_admin_idx")
  @@map("admin_audit_events")
}
