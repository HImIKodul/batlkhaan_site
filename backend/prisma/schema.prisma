  parentAssessment       Assessment?                     @relation("AssessmentParent", fields: [parentAssessmentId], references: [id], onDelete: SetNull)
  childAssessments       Assessment[]                    @relation("AssessmentParent")
  previousAssessment     Assessment?                     @relation("AssessmentPrevious", fields: [previousAssessmentId], references: [id], onDelete: SetNull)
  nextAssessments        Assessment[]                    @relation("AssessmentPrevious")
