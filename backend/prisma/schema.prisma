  /// Null only for origin ADMIN_GRANT (database CHECK company_entitlements_origin_check); every PAID entitlement keeps its invoice.
  sourceInvoiceId  String?           @unique
  planCode         BillingPlanCode
  status           EntitlementStatus @default(ACTIVE)
  startsAt         DateTime          @default(now())
  endsAt           DateTime?
  assessmentLimit  Int?
  assessmentsUsed  Int               @default(0)
  origin           EntitlementOrigin @default(PAID)
  grantedByAdminId String?
  grantReason      String?
  revokedAt        DateTime?
  revokedByAdminId String?
  revokeReason     String?
