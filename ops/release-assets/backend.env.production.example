# BusinessMRI PRODUCTION environment template. PLACEHOLDERS ONLY. Copy to backend/.env on the server (not into any archive or Git).
# Windows: restrict the file to the service account and Administrators (icacls). Linux: chmod 600, owned by the service user.
NODE_ENV=production
MMRI_ENVIRONMENT=production
PORT=4000
# MANDATORY for a same-host reverse proxy: in production the API listens on 0.0.0.0 by default (container design). Bind it to loopback:
API_HOST=127.0.0.1
# Bind address is the API default (loopback). The reverse proxy (IIS/ARR or nginx) is the only public listener.
ALLOWED_ORIGINS=https://businessmri.mn
MMRI_PUBLIC_APP_URL=https://businessmri.mn
COOKIE_SECURE=true
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
MMRI_API_REPLICA_COUNT=1
RELEASE_SHA=<git short hash printed in BUILD_INFO.json>

# ---- Database (same machine, loopback only, TLS verified) -------------------------------------------------------------
# The production guard rejects the literals localhost/127.0.0.1/::1 and requires sslaccept=strict (verified: the Prisma 6.15 engine does NOT
# verify the server certificate for sslmode=verify-full alone). Use an internal name that resolves to 127.0.0.1 via the hosts file
# (Windows: C:\Windows\System32\drivers\etc\hosts, Linux: /etc/hosts):   127.0.0.1  db.businessmri.internal
# PostgreSQL must have ssl=on with a server certificate whose SAN contains db.businessmri.internal, and listen_addresses='127.0.0.1'.
# sslcert is the CA file (URL-encode the path; Windows example: C%3A%5CMMRI%5Cpki%5Cpg-ca.crt).
DATABASE_URL=postgresql://mmri_runtime:<RUNTIME_DB_PASSWORD>@db.businessmri.internal:5432/mmri?schema=public&sslmode=require&sslaccept=strict&sslcert=<URL-ENCODED-CA-PATH>
# MIGRATION_DATABASE_URL is NEVER placed in this file: the API refuses to start if it is present. Export it only in the operator shell for `prisma migrate deploy`.

# ---- Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" -----------
ACCESS_TOKEN_SECRET=<GENERATE>
PASSWORD_PEPPER=<GENERATE: never rotate without a migration plan>
AUDIT_HASH_SALT=<GENERATE>
# Required (the API and ops/preflight.mjs refuse to start without it); must differ from the three secrets above.
METRICS_TOKEN=<GENERATE>
ACCESS_TOKEN_ISSUER=mmri-api
ACCESS_TOKEN_AUDIENCE=mmri-web
MMRI_OPERATOR_USER_IDS=<immutable ids of operator accounts; MMRI_OPERATOR_EMAILS is rejected in production>

# ---- Billing. Prices are set in code/env: 300000 each (approved). Enforcement is mandatory in production. ---------------------
MMRI_BILLING_ENFORCEMENT=true
MMRI_DIAGNOSTIC_PRICE_MNT=300000
MMRI_RETAKE_PRICE_MNT=300000
# Choose ONE payment mode. mock is rejected in production. Until live QPay is verified, the paid launch is BLOCKED.
#  (a) QPay:   MMRI_BILLING_PROVIDER=qpay  + QPAY_BASE_URL / QPAY_CLIENT_ID / QPAY_CLIENT_SECRET / QPAY_INVOICE_CODE / MMRI_BILLING_CALLBACK_BASE_URL=https://businessmri.mn
#  (b) Manual: MMRI_BILLING_PROVIDER=manual + MMRI_MANUAL_PAYMENT_QR_TEXT (or _QR_IMAGE / _SHORT_URL) ; payments confirmed by an operator
#  (c) Grant pilot (no payment collected; access only via audited administrator grants):
#      MMRI_BILLING_PROVIDER=grant + MMRI_PILOT_GRANT_AUTHORIZED_BY=<name of the person who authorised the pilot> + MMRI_PILOT_GRANT_EXPIRES=<ISO date-time, at most 120 days ahead>
#      Every grant then needs a reason and a written authorisation reference; after the expiry no grant can be created.
MMRI_BILLING_PROVIDER=<qpay|manual|grant>
# QPay values: run `bash ops/set-qpay-credentials.sh` (private file outside the repository), then `node backend/scripts/qpay-smoke.mjs <file>` (no invoice, no payment).
# MMRI_INVOICE_TTL_MINUTES=30          how long one QPay code is offered
# The 12-month plan (paid model call at report creation). Without this line no report has a plan.
MMRI_AI_ANNUAL_PLAN=on
# One paid attempt per report; a failed one goes to the administrator instead of repeating by itself.
MMRI_AI_REPORT_MAX_AUTO_ATTEMPTS=1
# Used only to show the cost in the audit log (USD per million tokens, gpt-6.1-terra).
MMRI_AI_PRICE_INPUT_USD_PER_M=1
MMRI_AI_PRICE_OUTPUT_USD_PER_M=5
# MMRI_AI_PLAN_MAX_RECOVERIES=2        administrator-authorised attempts for a report without a plan
# MMRI_PDF_ALLOW_GENERATOR_UPGRADE     leave unset; YES lets an operator re-create a LOST historical PDF as a new version

# ---- Report review policy ----------------------------------------------------------------------------------------------------
MMRI_REPORT_REVIEW_REQUIRED=true
# Identifies this instance in logs/health (required by ops/preflight.mjs).
INSTANCE_ID=<unique name, e.g. mmri-prod-1>
# native = Windows service / systemd install (no container image digests); leave unset only for the container topology.
MMRI_DEPLOY_MODE=native
MMRI_REPORT_REVIEW_ENFORCED_SINCE=<ISO timestamp of go-live>
MMRI_REPORT_REVIEW_TARGET_HOURS=24
MMRI_REPORT_STORAGE_DIR=<absolute path outside the application folder, e.g. D:\MMRI\report-storage>
MMRI_PDF_PYTHON_PATH=<python executable, e.g. C:\Python312\python.exe or python3>
# Optional: MMRI_PDF_FONT_REGULAR / MMRI_PDF_FONT_BOLD (default: fonts bundled in backend/pdf_renderer/fonts)

# ---- Customer notifications and lifecycle e-mails. BOTH DEFAULT TO OFF: without them customers get no in-app notification and no 'report ready' e-mail.
MMRI_CUSTOMER_NOTIFICATIONS=on
MMRI_CUSTOMER_EMAILS=on
# ---- Mail (Gmail API with OAuth refresh token; no passwords). mock is rejected in production. -----------------------------------
MMRI_MAIL_PROVIDER=gmail
MMRI_SUPPORT_MAIL_PROVIDER=gmail   # allowed values: off | mock | gmail (mock is rejected in production)
GMAIL_USER=<existing business mailbox>
GMAIL_CLIENT_ID=<oauth client id>
GMAIL_CLIENT_SECRET=<oauth client secret>
GMAIL_REFRESH_TOKEN=<from backend/scripts/gmail-authorize.mjs>
MMRI_MAIL_FROM=<display name and address of the authorised mailbox>
MMRI_ADMIN_ALERT_EMAILS=<comma separated addresses of ACTIVE administrators>
# MMRI_MAIL_RECIPIENT_ALLOWLIST must stay UNSET in production (QA safety net that would block real customers).

# ---- AI (report narrative + AI Scan). Without credits the system falls back to local checks and says so. ----------------------
MMRI_AI_REPORT_PROVIDER=openai
MMRI_AI_REPORT_REQUIRED=<true|false  (owner decision: true means no report is produced while the provider is unavailable)>
MMRI_AI_REPORT_MODEL=<model id>
MMRI_AI_REPORT_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_API_KEY=<key>
MMRI_AI_SCAN_PROVIDER=<openai|off>
# Hunspell (spell check): executable is a server prerequisite; dictionary ships in backend/resources/hunspell.
# MMRI_HUNSPELL_BIN=<path to hunspell executable>   MMRI_HUNSPELL_DIR=<override dictionary folder>
